        <!-- NEW: users to partnerRecipes / partnerRecipeLikes -->
        <mxCell id="e_partnerRecipes" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;strokeColor=#d6b656;" edge="1" parent="1" source="users" target="partnerRecipes">
