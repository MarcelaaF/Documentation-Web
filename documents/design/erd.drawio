        <mxCell id="e_fav_partnerRecipes" value="0..* : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;startArrow=none;html=1;fontSize=11;strokeColor=#d6b656;exitX=1;exitY=0.85;entryX=0;entryY=0.9;" edge="1" parent="1" source="favorites" target="partnerRecipes">
