        <mxCell id="e_weightLogs" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="weightLogs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_waterLogs" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="waterLogs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_reminders" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="reminders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_foodRecognitions" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="foodRecognitions">
          <mxGeometry relative="1" as="geometry" />
