        <mxCell id="e_userRecipes" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="userRecipes">
          <mxGeometry relative="1" as="geometry" />
