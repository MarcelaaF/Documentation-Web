        <!-- favorites/recipes/partnerRecipes relationships -->
        <mxCell id="e_fav_recipes" value="1 : 0..*" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="favorites" target="recipes">
          <mxGeometry relative="1" as="geometry" />
