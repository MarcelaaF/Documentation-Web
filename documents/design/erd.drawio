<mxfile host="app.diagrams.net">
  <diagram name="ERD" id="erd1">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 4 — Entity Relationship Diagram (Firestore collections)" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;users (doc id = uid)&lt;/b&gt;&lt;hr&gt;email&lt;br&gt;role {user | admin | business_partner}&lt;br&gt;status {active | suspended}&lt;br&gt;fullName, businessName&lt;br&gt;createdAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="profiles" value="&lt;b&gt;profiles (doc id = uid_profile)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;age, gender, height, weight&lt;br&gt;activityLevel, healthGoal&lt;br&gt;dietaryPreference, allergies[]&lt;br&gt;calorieGoalValue / Period&lt;br&gt;phone&lt;br&gt;bloodPressure (encrypted)&lt;br&gt;medicalConditions[] (encrypted)&lt;br&gt;pastSurgeries[], injuries[] (encrypted)&lt;br&gt;businessName, contactPerson" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="partnerProfiles" value="&lt;b&gt;partnerProfiles (doc id = uid)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;displayName, businessType&lt;br&gt;address, email, telephone&lt;br&gt;description&lt;br&gt;status {pending | active | rejected}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="partnerRecipes" value="&lt;b&gt;partnerRecipes (auto-generated id)&lt;/b&gt;&lt;hr&gt;partnerId (FK → users)&lt;br&gt;partnerName&lt;br&gt;name, mealCategory, calories&lt;br&gt;ingredients[], preparationSteps[]&lt;br&gt;dietTypes[], allergens[]&lt;br&gt;status {draft | published}&lt;br&gt;views, saves, likes&lt;br&gt;createdAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="320" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="partnerRecipeLikes" value="&lt;b&gt;partnerRecipeLikes (doc id = uid_recipeId)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;recipeId (FK → partnerRecipes)&lt;br&gt;createdAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="580" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="foods" value="&lt;b&gt;foods (shared catalog, auto-generated id)&lt;/b&gt;&lt;hr&gt;name, category&lt;br&gt;servingSize&lt;br&gt;calories, protein, carbohydrates, fat" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="60" width="380" height="130" as="geometry" />
        </mxCell>

        <mxCell id="mealLogs" value="&lt;b&gt;mealLogs (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;mealName, mealType, servingSize&lt;br&gt;calories, protein, carbs, fat&lt;br&gt;loggedAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="weightLogs" value="&lt;b&gt;weightLogs (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;weight&lt;br&gt;loggedAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="waterLogs" value="&lt;b&gt;waterLogs (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;loggedAt&lt;br&gt;(one document per glass logged)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="830" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="reminders" value="&lt;b&gt;reminders (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;title, message&lt;br&gt;scheduledAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="980" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="foodRecognitions" value="&lt;b&gt;foodRecognitions (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;recognizedFoodName&lt;br&gt;confidence, createdAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1130" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="userRecipes" value="&lt;b&gt;userRecipes (auto-generated id)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;name, ingredients[], steps[]&lt;br&gt;calories, protein, fat&lt;br&gt;servingSize, prepTimeMinutes&lt;br&gt;difficulty, createdAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1280" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="favorites" value="&lt;b&gt;favorites (doc id = uid_recipeId)&lt;/b&gt;&lt;hr&gt;userId (FK → users)&lt;br&gt;recipeId (FK → recipes or partnerRecipes)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1470" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="recipes" value="&lt;b&gt;recipes (shared catalog, auto-generated id)&lt;/b&gt;&lt;hr&gt;name, mealCategory&lt;br&gt;ingredients[], preparationSteps[]&lt;br&gt;calories, dietTypes[]&lt;br&gt;allergens[], cautionTags[]&lt;br&gt;hasDietaryInfo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1470" width="380" height="150" as="geometry" />
        </mxCell>

        <!-- Edges: users to per-user collections -->
        <mxCell id="e_profiles" value="1 : 0..1" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="profiles">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_partnerProfiles" value="1 : 0..1" style="edgeStyle=none;endArrow=none;startArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="users" target="partnerProfiles">
          <mxGeometry relative="1" as="geometry" />
