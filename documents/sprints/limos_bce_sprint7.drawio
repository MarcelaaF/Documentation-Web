        <mxCell id="ti" value="BCE diagram #11  -  Start a chat session" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1300" height="28" as="geometry"/></mxCell><mxCell id="st" value="As a premium user, I want to initiate a chat session with my chosen nutritionist so that I can receive personalised nutrition advice and support." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1340" height="36" as="geometry"/></mxCell><mxCell id="hc0" value="BOUNDARY  (screens)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl0" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="116" as="sourcePoint"/><mxPoint x="400" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc1" value="CONTROL  (controllers)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="560" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="116" as="sourcePoint"/><mxPoint x="920" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc2" value="ENTITY  (data)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl2" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="116" as="sourcePoint"/><mxPoint x="1440" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;NutritionistProfilePage&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : openChatRoom(sessionId, nutritionistId, name)&lt;/div&gt;&lt;div&gt;Void : displayStartError()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="111" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;AppUser? : currentAccount()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="145" width="360" height="81" as="geometry"/></mxCell><mxCell id="e1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;AppUser&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : id, fullName&lt;/div&gt;&lt;div&gt;(UserRepository) fetchUser(String uid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="137" width="360" height="96" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;ChatController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Future&amp;lt;String&amp;gt; : startOrResumeSession(String memberId, String nutritionistId, String memberName, String nutritionistName)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="302" width="360" height="111" as="geometry"/></mxCell><mxCell id="e2" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;ChatThread&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : memberId, nutritionistId, status&lt;/div&gt;&lt;div&gt;DateTime : startedAt, lastMessageAt&lt;/div&gt;&lt;div&gt;(ChatRepository) findActiveSessionId(...)&lt;/div&gt;&lt;div&gt;(ChatRepository) startSession(...)&lt;/div&gt;&lt;div&gt;(ChatRepository) completeSession(id, reason)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="287" width="360" height="141" as="geometry"/></mxCell><mxCell id="edge1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="b1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c1" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="b1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c2" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The member taps Start chat; the screen asks who the member is.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; The member's account record is read to get their name.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The screen asks to start or resume a session with this nutritionist.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; An active session is reused; an idle one is closed; otherwise a new session is created. The chat room then opens.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B3A369;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="1400" height="128" as="geometry"/></mxCell>
