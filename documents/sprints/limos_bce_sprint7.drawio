        <mxCell id="ti" value="BCE diagram #9  -  Browse verified nutritionist profiles" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1300" height="28" as="geometry"/></mxCell><mxCell id="st" value="As a premium user, I want to browse verified nutritionist profiles so that I can choose a suitable nutritionist for my dietary needs and goals." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1340" height="36" as="geometry"/></mxCell><mxCell id="hc0" value="BOUNDARY  (screens)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl0" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="116" as="sourcePoint"/><mxPoint x="400" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc1" value="CONTROL  (controllers)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="560" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="116" as="sourcePoint"/><mxPoint x="920" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc2" value="ENTITY  (data)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl2" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="116" as="sourcePoint"/><mxPoint x="1440" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;NutritionistListPage&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : displayNutritionistCards(List&amp;lt;PartnerProfile&amp;gt;)&lt;/div&gt;&lt;div&gt;Void : displayLoading()&lt;/div&gt;&lt;div&gt;Void : displayEmpty()&lt;/div&gt;&lt;div&gt;Void : displayError()  (with Retry)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="141" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerProfileController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Stream&amp;lt;List&amp;lt;PartnerProfile&amp;gt;&amp;gt; : watchVerified()&lt;/div&gt;&lt;div&gt;Future&amp;lt;String&amp;gt; : loadPhoto(PartnerProfile profile)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="137" width="360" height="126" as="geometry"/></mxCell><mxCell id="e1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerProfile&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : displayName, qualifications&lt;/div&gt;&lt;div&gt;List&amp;lt;String&amp;gt; : specialisations&lt;/div&gt;&lt;div&gt;Int : yearsExperience&lt;/div&gt;&lt;div&gt;Boolean : verified&lt;/div&gt;&lt;div&gt;(PartnerProfileRepository) watchVerified()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="360" height="141" as="geometry"/></mxCell><mxCell id="b2" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;NutritionistPhotoAvatar&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : displayPhoto(String photoBase64)&lt;/div&gt;&lt;div&gt;Void : displayInitial(String name)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="360" height="96" as="geometry"/></mxCell><mxCell id="e2" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;NutritionistPhoto&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : photoBase64&lt;/div&gt;&lt;div&gt;(PartnerProfileRepository) fetchPhoto(String uid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="317" width="360" height="111" as="geometry"/></mxCell><mxCell id="edge1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="b1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c1" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="b2" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The list screen asks for the verified nutritionists.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Only admin-approved profiles are read (name, qualifications, experience, specialisations).&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Each card asks for its photo when it scrolls into view.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The photo is fetched once from its own record, then remembered; until then the initial is shown.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B3A369;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="1400" height="128" as="geometry"/></mxCell>
