116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerRegisterPage&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : displayRegistrationForm()&lt;/div&gt;&lt;div&gt;Void : displayEmailInUse()  (&quot;Log in instead&quot;)&lt;/div&gt;&lt;div&gt;Void : displaySubmitted()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="137" width="360" height="126" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : register(fullName, email, password, role, businessName, qualifications, specialisations, yearsExperience, credentialBase64)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="145" width="360" height="111" as="geometry"/></mxCell><mxCell id="e1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerProfile&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : displayName, qualifications&lt;/div&gt;&lt;div&gt;List&amp;lt;String&amp;gt; : specialisations&lt;/div&gt;&lt;div&gt;Int : yearsExperience&lt;/div&gt;&lt;div&gt;String : status = pending&lt;/div&gt;&lt;div&gt;(UserRepository) createUserAndProfile(...)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="360" height="141" as="geometry"/></mxCell><mxCell id="e2" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;NutritionistCredential&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : imageBase64  (JPEG / PNG)&lt;/div&gt;&lt;div&gt;Private: owner and admins only&lt;/div&gt;&lt;div&gt;(UserRepository) createUserAndProfile(...)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="317" width="360" height="111" as="geometry"/></mxCell><mxCell id="edge1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="b1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c1" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontStyle=1;labelBackgroundColor=#FFE9A8;labelBorderColor=#B3A369;" edge="1" parent="1" source="c1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The nutritionist fills in the form and attaches a certificate or licence, then submits.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; One batch creates the account, the profile (status pending) and the credential record.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;margin-top:3px;&quot;&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The credential is stored privately in the same batch, so there is never an application without it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B3A369;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="1400" height="106" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="BCE16 Admin verifies a nutritionist">
