        <mxCell id="ti" value="BCE diagram #17  -  Rejected nutritionist resubmits or deletes the account" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1300" height="28" as="geometry"/></mxCell><mxCell id="st" value="Supporting flow: a rejected nutritionist either updates their details and resubmits, or deletes the account and registers again." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1340" height="36" as="geometry"/></mxCell><mxCell id="hc0" value="BOUNDARY  (screens)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl0" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="116" as="sourcePoint"/><mxPoint x="400" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc1" value="CONTROL  (controllers)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="560" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="116" as="sourcePoint"/><mxPoint x="920" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="hc2" value="ENTITY  (data)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="360" height="22" as="geometry"/></mxCell><mxCell id="hl2" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="116" as="sourcePoint"/><mxPoint x="1440" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerEditProfilePage&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : displayEditForm()&lt;/div&gt;&lt;div&gt;Void : displayResubmitted()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="360" height="96" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerProfileController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;Void : saveCredential(String uid, String imageBase64)&lt;/div&gt;&lt;div&gt;Void : save(uid, details, ...)&lt;/div&gt;&lt;div&gt;Void : resubmitApplication(String uid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="360" height="126" as="geometry"/></mxCell><mxCell id="e1" value="&lt;div style=&quot;font-size:11px;color:#444;&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PartnerProfile&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0;border-color:#000;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding:0 8px 6px 8px;white-space:normal;&quot;&gt;&lt;div&gt;String : status  (re